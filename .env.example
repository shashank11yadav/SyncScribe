# Copy to .env and fill in. Every app in the workspace reads this one file in
# development; in production set the same names on each host.

# --- Database (web, sync, migrations) ---
# Local: the docker compose Postgres on port 5433.
# Production: Neon. Give the web app the pooled URL and the sync server the
# direct (non-pooler) URL, because LISTEN/NOTIFY does not work through PgBouncer.
DATABASE_URL=postgres://syncscribe:syncscribe@localhost:5433/syncscribe
# Used only by the integration tests. Must point at a throwaway database.
TEST_DATABASE_URL=postgres://syncscribe:syncscribe@localhost:5433/syncscribe_test

# --- Auth.js (web) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth app credentials. See README "Run the full app locally".
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Needed when not running on Vercel (for example `next start` behind a proxy).
AUTH_TRUST_HOST=true

# --- Sync tokens (web and sync, must match) ---
# Shared HMAC key for the short-lived websocket tokens. At least 32 characters.
# Generate with: openssl rand -base64 32 (a separate run from AUTH_SECRET)
SYNC_TOKEN_SECRET=

# --- Web ---
# Public websocket URL of the sync server, as the browser should reach it.
NEXT_PUBLIC_SYNC_URL=ws://localhost:5201

# --- Sync server ---
PORT=5201
# Comma-separated web origins allowed to open websockets.
ALLOWED_ORIGINS=http://localhost:5200
# How often an edited document gets an automatic version (seconds).
SNAPSHOT_INTERVAL_SECONDS=600
# How often the public sandbox is wiped back to its welcome text (minutes).
SANDBOX_RESET_MINUTES=30
# Size cap for the sandbox document before it is reset early (bytes).
SANDBOX_MAX_BYTES=262144
